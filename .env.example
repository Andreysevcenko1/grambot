# ---------------------------------------------------------------------------
# Telegram (обязательно)
# Токен бота выдаёт @BotFather. TELEGRAM_CHAT_ID — ваш user id (или id группы /
# канала), куда слать сигналы. Узнать: напишите боту, затем откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates и найдите "chat":{"id":...}.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Отвечать на команды (/status, /price, /recent, /stats, /feeds, /mute ...).
ENABLE_COMMANDS=true
# Присылать сообщение при старте бота.
SEND_STARTUP_MESSAGE=true

# ---------------------------------------------------------------------------
# Источники через запятую: RSS/Atom-ленты и Telegram-каналы. По умолчанию:
# Google News (агрегатор сотен изданий), Cointelegraph, Decrypt, CryptoSlate,
# The Block, релизы ton-blockchain/ton и официальные Telegram-каналы
# (@tonblockchain, @toncoin, @tonstatus, @durov, @telegram,
# @binance_announcements) и канал @whale_alert_io (крупные переводы TON —
# идут в /whales, а не в новости). Telegram-каналы читаются напрямую со страницы
# https://t.me/s/<канал> — добавляйте любой публичный канал как
# https://t.me/s/<канал> или @<канал>, RSSHub не нужен.
# Оставьте пустым, чтобы использовать встроенный список по умолчанию.
# ---------------------------------------------------------------------------
RSS_FEEDS=

# Ключевые слова релевантности (через запятую). Короткие тикеры в верхнем
# регистре (TON, GRAM) сравниваются с учётом регистра, чтобы не ловить
# "ton of steel" и "1 gram of salt". Пусто = список по умолчанию.
KEYWORDS=

# Источники, которым верим без второго подтверждения: подстрока имени
# источника (без учёта регистра) или Telegram-канал как @имя / t.me/имя.
# Пусто = официальные каналы TON, Durov, Telegram и Binance Announcements.
TRUSTED_SOURCES=

# ---------------------------------------------------------------------------
# Расписание и фильтры
# ---------------------------------------------------------------------------
# Ленты и Telegram-каналы опрашиваются каждые 3 минуты (минимум 30 с).
POLL_INTERVAL_SECONDS=180
PRICE_POLL_INTERVAL_SECONDS=120
# Таймаут запроса к одной ленте, сек.
FEED_TIMEOUT_SECONDS=15
# Не рассматривать новости старше N часов (ленты отдают недельный хвост).
MAX_ITEM_AGE_HOURS=24
# Минимальная сила сигнала для уведомления: low, medium, high.
MIN_NOTIFY_STRENGTH=low
# Окно (мин), в котором похожие заголовки объединяются в одно событие.
CLUSTER_WINDOW_MINUTES=120
# Сколько независимых источников нужно, чтобы считать новость подтверждённой.
MIN_SOURCES_FOR_VERIFIED=2
# Антиспам: не больше N уведомлений в час.
MAX_NOTIFICATIONS_PER_HOUR=10

# ---------------------------------------------------------------------------
# Цена: CoinGecko (без ключа), при сбое/лимите — Binance → Bybit → OKX.
# ---------------------------------------------------------------------------
COINGECKO_COIN_ID=the-open-network
# Тикер на биржах (после ребрендинга TON → GRAM).
PRICE_SYMBOL=GRAMUSDT
# Валюта для отображения рядом с долларом (EUR, RUB, UAH, KZT, GBP…). USD — только доллар.
DISPLAY_CURRENCY=USD
# Быстрое окно (мин) и порог резкого движения: алерт, если |изменение| >= N %.
PRICE_WINDOW_MINUTES=20
PRICE_ALERT_THRESHOLD_PCT=4
# Медленные окна для плавных движений: МИНУТЫ:ПРОЦЕНТ через запятую.
# Каждое окно срабатывает один раз и «перезаряжается», когда движение
# откатывается ниже половины порога (без повторов каждый час при затяжном росте).
# По 30 дням истории GRAM: 2,5 %/ч ≈ 0,4 сигнала в день, 3,5 %/ч ≈ 0,2.
PRICE_ALERT_WINDOWS=60:2.5,240:5,1440:8
# Не чаще одного ценового алерта в N минут (общий для всех окон).
PRICE_ALERT_COOLDOWN_MINUTES=60
# ⚡ Импульс — раннее предупреждение: |изменение| за быстрое окно >= FAST %
# и за час >= SLOW % в ту же сторону (SLOW=0 — без подтверждения часом).
# Приходит раньше обычного сигнала, но ~60 % импульсов не продолжаются;
# помечен как неподтверждённый. false — выключить.
ENABLE_IMPULSE_ALERTS=true
IMPULSE_FAST_PCT=2
IMPULSE_SLOW_PCT=1.5
IMPULSE_COOLDOWN_MINUTES=60
# Всплеск объёма: часовой оборот по 5-минутным свечам (Binance → Bybit → OKX)
# в N раз выше медианы за прошлые сутки И цена за час сдвинулась на >= M %
# (M=0 — только по объёму). Отдельный cooldown. false — выключить.
ENABLE_VOLUME_ALERTS=true
VOLUME_SPIKE_RATIO=4
VOLUME_SPIKE_MIN_MOVE_PCT=2
VOLUME_ALERT_COOLDOWN_MINUTES=180
VOLUME_POLL_INTERVAL_SECONDS=300
# Пока рынок «в движении» (сработало любое окно или объём), свежая новость
# из одного источника показывается сразу с пометкой «совпадает с движением
# рынка», не дожидаясь второго издания. Не больше N таких за активный период.
MARKET_CONFIRMS_NEWS=true
MARKET_ACTIVE_MINUTES=180
MARKET_CONFIRMED_NEWS_LIMIT=3

# ---------------------------------------------------------------------------
# Деривативы (бессрочные фьючерсы GRAMUSDT): ставка финансирования, открытый
# интерес (OI) и ликвидации. Публичные данные Bybit → Binance → OKX без ключей,
# ликвидации — только OKX. Сигналы информационные, с объяснением «что это значит».
# ---------------------------------------------------------------------------
ENABLE_FUTURES_ALERTS=true
FUTURES_POLL_INTERVAL_SECONDS=300
# |ставка финансирования| в пересчёте на сутки, %. Для GRAM 0,1 %/день — 95-й
# процентиль, 0,15 % бывает ~раз в неделю. 0 — не следить за ставкой.
FUNDING_ALERT_DAILY_PCT=0.15
# Изменение открытого интереса: МИНУТЫ:ПРОЦЕНТ. Сравнивается с историей самого
# бота, поэтому окно 24 ч заработает через сутки после запуска.
OI_ALERT_WINDOWS=60:4,240:6,1440:10
# Ликвидации за последний час в долларах (OKX), 0 — выключить.
LIQUIDATION_ALERT_USD=250000
# Каждый триггер срабатывает один раз, перезаряжается ниже половины порога и
# не повторяется чаще N минут.
FUTURES_ALERT_COOLDOWN_MINUTES=180

# ---------------------------------------------------------------------------
# Ончейн: крупные переводы и состояние сети через TON Center (toncenter.com).
# Сканируются все внутренние сообщения сети — это ~2 ГБ трафика в сутки.
# Если выключено, крупные переводы всё равно приходят из канала Whale Alert
# (порог WHALE_MIN_TON и cooldown ниже действуют и для них).
# ---------------------------------------------------------------------------
ENABLE_ONCHAIN=true
# Бесплатный ключ выдаёт бот @tonapibot в Telegram; без ключа ~1 запрос/с.
TONCENTER_API_KEY=
ONCHAIN_POLL_INTERVAL_SECONDS=120
# Уведомлять о переводах от N TON (в /whales попадают переводы от N/10).
WHALE_MIN_TON=500000
# Не чаще одного ончейн-алерта в N минут (переводы ≥ 2×WHALE_MIN_TON проходят всегда).
ONCHAIN_ALERT_COOLDOWN_MINUTES=10
# Сколько страниц по 1000 сообщений читать за один опрос (при отставании бот догоняет чаще).
ONCHAIN_MAX_PAGES=8
# Алерт «сеть остановилась», если последний блок мастерчейна старше N минут.
NETWORK_STALL_MINUTES=5
# Метки адресов (биржи, фонды, DEX) — датасет ton-studio/ton-labels, обновляется раз в сутки.
LABELS_URL=https://raw.githubusercontent.com/shuva10v/ton-labels/build/assets.json

# ---------------------------------------------------------------------------
# Хранилище
# ---------------------------------------------------------------------------
DATABASE_PATH=grambot.db
# Сколько дней хранить новости и историю цен (сигналы хранятся всегда).
RETENTION_DAYS=30
# DEBUG, INFO, WARNING
LOG_LEVEL=INFO
# Файл лога с ротацией (5 МБ × 3). Пусто = только stdout (Docker/launchd собирают сами).
LOG_FILE=

# ---------------------------------------------------------------------------
# Автономная работа (значения по умолчанию подходят для хостинга)
# ---------------------------------------------------------------------------
# Порог памяти: при превышении бот сам перезапускается (супервизор поднимает его заново).
MAX_MEMORY_MB=512
# Если главный цикл не подаёт признаков жизни столько минут — принудительный перезапуск.
WATCHDOG_TIMEOUT_MINUTES=20
# Уведомление в Telegram, если источник (ленты/цена/ончейн/Telegram) недоступен дольше N минут.
HEALTH_ALERT_MINUTES=60
# Файл «пульса» для `python main.py --healthcheck`. Пусто = <DATABASE_PATH>.heartbeat
HEARTBEAT_PATH=

# ---------------------------------------------------------------------------
# Необязательно: LLM-классификация (любой OpenAI-совместимый API).
# Пусто = встроенные правила (бесплатно, без ключа). При ошибках API бот сам
# откатывается на правила, уведомления не теряются.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
