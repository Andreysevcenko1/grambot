# ---------------------------------------------------------------------------
# Telegram (обязательно)
# Токен бота выдаёт @BotFather. TELEGRAM_CHAT_ID — ваш user id (или id группы /
# канала), куда слать сигналы. Узнать: напишите боту, затем откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates и найдите "chat":{"id":...}.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Отвечать на команды (/status, /price, /recent, /stats, /feeds, /mute ...).
ENABLE_COMMANDS=true
# Присылать сообщение при старте бота.
SEND_STARTUP_MESSAGE=true

# ---------------------------------------------------------------------------
# Источники (RSS/Atom через запятую). По умолчанию: Google News (агрегатор
# сотен изданий), Cointelegraph, Decrypt, CryptoSlate, The Block и Telegram-
# каналы TON/Durov/Telegram через публичный RSSHub. Публичные RSSHub могут
# отваливаться — для надёжности поднимите свой (см. README, docker compose
# --profile rsshub) и замените базовый URL.
# Оставьте пустым, чтобы использовать встроенный список по умолчанию.
# ---------------------------------------------------------------------------
RSS_FEEDS=

# Ключевые слова релевантности (через запятую). Короткие тикеры в верхнем
# регистре (TON, GRAM) сравниваются с учётом регистра, чтобы не ловить
# "ton of steel" и "1 gram of salt". Пусто = список по умолчанию.
KEYWORDS=

# Источники, которым верим без второго подтверждения (подстрока имени
# источника, без учёта регистра). Пусто = официальные Telegram-каналы TON.
TRUSTED_SOURCES=

# ---------------------------------------------------------------------------
# Расписание и фильтры
# ---------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=300
PRICE_POLL_INTERVAL_SECONDS=120
# Таймаут запроса к одной ленте, сек.
FEED_TIMEOUT_SECONDS=15
# Не рассматривать новости старше N часов (ленты отдают недельный хвост).
MAX_ITEM_AGE_HOURS=24
# Минимальная сила сигнала для уведомления: low, medium, high.
MIN_NOTIFY_STRENGTH=low
# Окно (мин), в котором похожие заголовки объединяются в одно событие.
CLUSTER_WINDOW_MINUTES=120
# Сколько независимых источников нужно, чтобы считать новость подтверждённой.
MIN_SOURCES_FOR_VERIFIED=2
# Антиспам: не больше N уведомлений в час.
MAX_NOTIFICATIONS_PER_HOUR=10

# ---------------------------------------------------------------------------
# Цена: CoinGecko (без ключа), при сбое/лимите — Binance → Bybit → OKX.
# ---------------------------------------------------------------------------
COINGECKO_COIN_ID=the-open-network
# Тикер на биржах (после ребрендинга TON → GRAM).
PRICE_SYMBOL=GRAMUSDT
# Окно (мин) для расчёта короткого движения цены.
PRICE_WINDOW_MINUTES=20
# Алерт о резком движении, если |изменение за окно| >= N %.
PRICE_ALERT_THRESHOLD_PCT=5
# Не чаще одного ценового алерта в N минут.
PRICE_ALERT_COOLDOWN_MINUTES=60

# ---------------------------------------------------------------------------
# Хранилище
# ---------------------------------------------------------------------------
DATABASE_PATH=grambot.db
# Сколько дней хранить новости и историю цен (сигналы хранятся всегда).
RETENTION_DAYS=30
# DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Необязательно: LLM-классификация (любой OpenAI-совместимый API).
# Пусто = встроенные правила (бесплатно, без ключа). При ошибках API бот сам
# откатывается на правила, уведомления не теряются.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
