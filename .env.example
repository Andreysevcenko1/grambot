# Telegram bot credentials. Create a bot via @BotFather and put the chat id
# (your user id, group id, or channel id) where notifications should be sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated RSS/Atom feed URLs to monitor. This can include official
# blogs, general crypto news outlets, a targeted Google News search feed
# (which aggregates many outlets), and Telegram channels via an RSSHub
# instance (RSSHub converts Telegram channels/X accounts to RSS so no
# platform is scraped directly). Public RSSHub/Nitter instances can be
# rate-limited or go offline; self-host RSSHub for reliability, see README.
RSS_FEEDS=https://news.google.com/rss/search?q=TON+OR+Toncoin+OR+GRAM+OR+%22The+Open+Network%22&hl=en-US&gl=US&ceid=US:en,https://cointelegraph.com/rss,https://decrypt.co/feed,https://cryptoslate.com/feed/,https://www.theblock.co/rss.xml,https://rsshub.rssforever.com/telegram/channel/tonblockchain,https://rsshub.rssforever.com/telegram/channel/tonstatus,https://rsshub.rssforever.com/telegram/channel/durov,https://rsshub.rssforever.com/telegram/channel/telegram

# Comma-separated keywords used to decide whether an item is relevant.
KEYWORDS=TON,Toncoin,GRAM,Telegram,The Open Network,TON Foundation

# How often to poll sources, in seconds.
POLL_INTERVAL_SECONDS=300

# How often to poll the TON price feed, in seconds.
PRICE_POLL_INTERVAL_SECONDS=120

# Minimum signal strength required to send a notification: low, medium, high.
MIN_NOTIFY_STRENGTH=low

# Window (minutes) used to cluster similar news items together and to count
# corroborating sources before notifying.
CLUSTER_WINDOW_MINUTES=120

# Minimum number of independent sources required before a signal is
# considered "verified" instead of an unverified rumor.
MIN_SOURCES_FOR_VERIFIED=2

# CoinGecko coin id used for TON price/volume lookups.
COINGECKO_COIN_ID=the-open-network

# Path to the local SQLite database file used for dedup/state.
DATABASE_PATH=grambot.db

# Optional: enable LLM-backed impact classification (OpenAI-compatible
# chat completions API). Leave OPENAI_API_KEY empty to use the built-in
# rule-based classifier, which requires no API key or cost. If set, the
# bot automatically falls back to the rule-based classifier on any API
# error, so this is safe to enable without risking missed notifications.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
